from telegram import Update, InlineKeyboardButton, InlineKeyboardMarkup
from telegram.ext import ApplicationBuilder, CommandHandler, MessageHandler, CallbackQueryHandler, ContextTypes, filters
import yt_dlp
import os
import uuid

BOT_TOKEN = os.getenv("BOT_TOKEN") # Railway me environment variable se lega
DOWNLOAD_DIR = "downloads"
os.makedirs(DOWNLOAD_DIR, exist_ok=True)

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    keyboard = [
        [InlineKeyboardButton("🎵 Send Song Name", callback_data="search")],
        [InlineKeyboardButton("📥 Send YouTube Link", callback_data="link")]
    ]
    reply_markup = InlineKeyboardMarkup(keyboard)
    await update.message.reply_text(
        "🎧 Welcome to Music Bot\n"
        "Send me a song name or YouTube link and I’ll send you the MP3.\n"
        "Example: `Alan Walker Faded`\n\n"
        "_Note: For personal use only_",
        reply_markup=reply_markup,
        parse_mode="Markdown"
    )

async def button_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    if query.data == "search":
        await query.edit_message_text("Type the song name now 🎶")
    elif query.data == "link":
        await query.edit_message_text("Paste the YouTube link now 📥")

async def download_music(update: Update, context: ContextTypes.DEFAULT_TYPE):
    text = update.message.text.strip()
    user_id = update.effective_user.id
    msg = await update.message.reply_text("⏳ Downloading... This may take 15-30 sec")

    filename = os.path.join(DOWNLOAD_DIR, f"{user_id}_{uuid.uuid4()}.mp3")

    ydl_opts = {
        'format': 'bestaudio/best',
        'outtmpl': filename,
        'quiet': True,
        'noplaylist': True,
        'postprocessors': [{
            'key': 'FFmpegExtractAudio',
            'preferredcodec': 'mp3',
            'preferredquality': '128', # 128kbps = light on Railway free tier
        }],
    }

    try:
        search_query = text if ("youtube.com" in text or "youtu.be" in text) else f"ytsearch1:{text}"

        with yt_dlp.YoutubeDL(ydl_opts) as ydl:
            info = ydl.extract_info(search_query, download=True)
            title = info['entries'][0]['title'] if 'entries' in info else info['title']
            duration = info['entries'][0]['duration'] if 'entries' in info else info.get('duration', 0)

        # Telegram limit 50MB
        if os.path.getsize(filename) > 50 * 1024 * 1024:
            await update.message.reply_text("❌ File is too large. Telegram limit is 50MB.")
            os.remove(filename)
            return

        await update.message.reply_audio(
            audio=open(filename, 'rb'),
            title=title,
            duration=duration,
            caption=f"🎵 {title}"
        )

    except Exception as e:
        await update.message.reply_text(f"❌ Download failed. Try another song.")
    finally:
        await msg.delete()
        if os.path.exists(filename):
            os.remove(filename) # Delete to save Railway storage

async def help_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text(
        "**How to use:**\n"
        "1. Send a song name like `Tum Hi Ho`\n"
        "2. Or send a YouTube link directly\n"
        "**Note:** For personal use only. Respect copyright laws."
    )

def main():
    if not BOT_TOKEN:
        print("Error: BOT_TOKEN not set in environment variables")
        return

    app = ApplicationBuilder().token(BOT_TOKEN).build()
    app.add_handler(CommandHandler("start", start))
    app.add_handler(CommandHandler("help", help_command))
    app.add_handler(CallbackQueryHandler(button_handler))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, download_music))

    print("Bot is running...")
    app.run_polling()

if __name__ == "__main__":
    main()
